# elite/ has its own .gitignore (node_modules, vendor, build, third-party).

# Third-party plugins (PRO Elements etc.): copied in locally, never committed.
/plugins/

*.zip
.DS_Store
*.log
node_modules/
.wp-env.override.json

# Measurement output: large and regenerated by the scripts next to it. The
# summaries the published figures come from are committed
# (content/results/phones-round2.json, server-round2.md), as is round 1.
/content/results/*/
!/content/results/round1-defaults/
/content/race/frames/
/content/race/out/
/content/showreel/out/
